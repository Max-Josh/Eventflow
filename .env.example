# Configuration GeniusPay pour EVENTFLOW
# Environnement : sandbox (test) ou live (production)
VITE_GENIUSPAY_ENV=sandbox

# Vos clés d'API GeniusPay (disponibles dans votre tableau de bord GeniusPay)
VITE_GENIUSPAY_PUBLIC_KEY=pk_test_geniuspay_votre_cle_publique
VITE_GENIUSPAY_SECRET_KEY=sk_test_geniuspay_votre_cle_secrete
